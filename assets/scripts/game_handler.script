local velocity = vmath.vector3()
local label

local key = false

local released = false
multi = 0
local mousepos = vmath.vector3()

local level = 1

function init(self)
	msg.post(".", "acquire_input_focus")
	
end

function final(self)
	
end

function update(self, dt)
	--[[
	go.set_position(go.get_position(player) + (velocity / 4), player)
	velocity = 3 * velocity / 4
	if math.abs(velocity.x) < .1 and math.abs(velocity.y) < .1 then
		velocity = vmath.vector3()
	end]]
	go.set("/background#Label", "text", "Power: " .. multi .. "|Level: " .. level)
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function reset()
	key = false
	go.set_position(vmath.vector3())
end

function on_message(self, message_id, message, sender)
	if message_id == hash("goal") then
		key = true
	elseif message.other_group == hash("exit") then
		if key then
			level = level + 1
			reset()
		else
			level = level
			reset()
		end
	end
	
	pprint(message)
end

function on_input(self, action_id, action)
	
	--Tbh either going to go with a mouse or a keyboard idk yet
	mousepos = camera.screen_to_world(vmath.vector3(action.x, action.y, 0))
	if action_id == hash("touch") and action.pressed and velocity == vmath.vector3() then
		multi = 0
		released = false
		timer.delay(.1, true, function(self, handle)
			multi = multi + 5
			if released or multi >= 100 then
				timer.cancel(handle)
			end
		end)
	elseif action_id == hash("touch") and action.released and multi > 0 and velocity == vmath.vector3() then
		released = true
		local tempvector = mousepos - go.get_position()
		local unit = tempvector / vmath.length(tempvector)
		pprint(unit * multi)
		msg.post("#collisionobject", "apply_force", {force = unit * multi, position = go.get_world_position()})
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
