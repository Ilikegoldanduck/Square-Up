local velocity = vmath.vector3()
local label

local key = false

local released = false
local multi = 0
local mousepos = vmath.vector3()

local level = 4

local levels = {
	{
		goal = vmath.vector3(100, 0, 0),
	},
	{
		goal = vmath.vector3(200, 0, 0),
		wall = {
			{vmath.vector3(100, 160, 0), vmath.vector3(120, -160, 0), "static"}
		}
	},
	{
		goal = vmath.vector3(200, 0, 0),
		wall = {
			{vmath.vector3(100, 100, 0), vmath.vector3(-100, 160, 0), vmath.vector3(0, -130, 0), 5}
		}
	},
	{
		goal = vmath.vector3(200, 0, 0),
		evil = {
			{vmath.vector3(-100, 100, 0), vmath.vector3(-160, -100, 0), vmath.vector3(130, 0, 0), 15}
		}
	}
}

local levelComponents = {}

function reset()
	key = false
	go.set("#collisionobject", "linear_velocity", vmath.vector3())
	go.set_position(vmath.vector3())
	for i, v in ipairs(levelComponents) do
		if go.exists(v) then
			go.delete(v)
		end
	end
	levelComponents = {}
	multi = 0
end

function generateLevel()
	local chosenLevel = levels[level]
	table.insert(levelComponents, factory.create("/background#goalfactory", chosenLevel.goal, nil, nil, 1))
	for i, v in ipairs(chosenLevel.wall or {}) do
		pprint(v)
		table.insert(levelComponents, factory.create("/background#wallfactory", v[1], nil, {position1 = v[1], position2 = v[2], property = v[3] or nil, propertyLength = v[4] or 0}, 1))
	end
	for i, v in ipairs(chosenLevel.evil or {}) do
		pprint(v)
		table.insert(levelComponents, factory.create("/background#evilfactory", v[1], nil, {position1 = v[1], position2 = v[2], property = v[3] or nil, propertyLength = v[4] or 0}, 1))
	end
	go.set("background#levelLabel", "text", tostring(level))
end

function init(self)
	msg.post(".", "acquire_input_focus")
	generateLevel()
end

function final(self)
	
end

function update(self, dt)
	--[[
	go.set_position(go.get_position(player) + (velocity / 4), player)
	velocity = 3 * velocity / 4
	if math.abs(velocity.x) < .1 and math.abs(velocity.y) < .1 then
		velocity = vmath.vector3()
	end]]
	go.set("/background#Label", "text", "Power: " .. multi .. "|Level: " .. level)
	
	--pprint(go.get("#collisionobject", "linear_velocity"))
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

