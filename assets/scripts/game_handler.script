	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("goal") then
		key = true
	elseif message.other_group == hash("evil") then
		reset()
		generateLevel()
	elseif message.other_group == hash("exit") then
		if key then
			level = level + 1
			reset()
		else
			reset()
		end
		generateLevel()
	end
	--pprint(message)
end

function on_input(self, action_id, action)
	
	--Tbh either going to go with a mouse or a keyboard idk yet
	local tempVelocity = go.get("#collisionobject", "linear_velocity")
	mousepos = camera.screen_to_world(vmath.vector3(action.x, action.y, 0))
	if action_id == hash("touch") and action.pressed and (math.abs(tempVelocity.x) < 5 and math.abs(tempVelocity.y) < 5) then
		multi = 0
		released = false
		timer.delay(.1, true, function(self, handle)
			if released then
				timer.cancel(handle)
			elseif multi >= 100 then

			else
				multi = multi + 5
			end
		end)
	elseif action_id == hash("touch") and action.released and tempVelocity == vmath.vector3() then
		released = true
		local tempvector = mousepos - go.get_position()
		local unit = tempvector / vmath.length(tempvector)
		pprint(unit * multi)
		msg.post("#collisionobject", "apply_force", {force = unit * multi * 100, position = go.get_world_position()})
		multi = 0
	elseif not action_id == hash("touch") then
		released = true
		multi = 0
	end
end

function on_reload(self)
